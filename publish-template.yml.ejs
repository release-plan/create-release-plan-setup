# For every push to the primary branch with .release-plan.json modified,
# runs release-plan.

name: Publish Stable

on:
  workflow_dispatch:
  push:
    branches:
      - main
      - master
    paths:
      - '.release-plan.json'

concurrency:
  group: publish-${{ github.head_ref || github.ref }}
  cancel-in-progress: true

jobs:
  publish:
    name: "NPM Publish"
    runs-on: ubuntu-latest
    permissions:
      contents: write
      id-token: write
      attestations: write

    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false<% if (pnpm) { %>
      - uses: pnpm/action-setup@73e46992e05b19abd31f2f3c20e0e7370d762115 # v6.1.1<% if (!hasPackageManager) { %>
        with:
          version: 9<% } %><% } %>
      - uses: actions/setup-node@249970729cb0ef3589644e2896645e5dc5ba9c38 #v6.5.0
        with:
          node-version: 24
          registry-url: 'https://registry.npmjs.org'<% if (pnpm) { %>
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      - name: Publish to NPM
        run: NPM_CONFIG_PROVENANCE=true pnpm release-plan publish<% } else { %>
      - run: npm ci
      - name: Publish to NPM
        run: npx release-plan publish --provenance<% } %>
        env:
          GITHUB_AUTH: ${{ secrets.GITHUB_TOKEN }}
